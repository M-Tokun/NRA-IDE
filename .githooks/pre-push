#!/bin/sh

set -u

is_zero_oid() {
    case "$1" in
        ""|*[!0]*) return 1 ;;
        *) return 0 ;;
    esac
}

repository_root=$(git rev-parse --show-toplevel) || {
    echo "pre-push gate: unable to resolve repository root" >&2
    exit 2
}

cd -- "$repository_root" || {
    echo "pre-push gate: unable to enter repository root" >&2
    exit 2
}

while IFS=' ' read -r local_ref local_oid remote_ref remote_oid
do
    if is_zero_oid "$local_oid"; then
        continue
    fi

    if is_zero_oid "$remote_oid"; then
        echo "pre-push gate: new remote refs require an explicitly reviewed base" >&2
        exit 2
    fi

    if ! command -v pwsh >/dev/null 2>&1; then
        echo "pre-push gate: pwsh is required for the Malware Gate" >&2
        exit 2
    fi

    pwsh -NoProfile -File scripts/malware_gate.ps1 \
        -Base "$remote_oid" \
        -Head "$local_oid"
    gate_exit=$?
    if [ "$gate_exit" -ne 0 ]; then
        echo "pre-push gate: push blocked with exit code $gate_exit" >&2
        exit "$gate_exit"
    fi
done

exit 0
