#!/bin/sh
# Git supplies the exact update set on stdin. This does not issue approval.
set -u
repository_root=$(git rev-parse --show-toplevel) || exit 2
cd -- "$repository_root" || exit 2
if ! command -v python >/dev/null 2>&1; then
    echo "pre-push gate: python is required" >&2
    exit 2
fi
exec python -B scripts/push_gate.py check "$@"
