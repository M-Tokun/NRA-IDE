{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/skills/agents-md-guard/codex_session_start.py\"",
            "commandWindows": "pwsh -NoProfile -Command \"$root = git rev-parse --show-toplevel; & python (Join-Path $root 'skills/agents-md-guard/codex_session_start.py')\"",
            "timeout": 10,
            "statusMessage": "Loading AGENTS.md",
            "additionalContextLimit": 12000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/skills/agents-md-guard/codex_guard.py\"",
            "commandWindows": "pwsh -NoProfile -Command \"$root = git rev-parse --show-toplevel; & python (Join-Path $root 'skills/agents-md-guard/codex_guard.py')\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
