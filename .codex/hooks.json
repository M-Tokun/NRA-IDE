{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/.codex/hooks/check.py\"",
            "commandWindows": "python -B -c \"import subprocess,runpy,os; r=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip(); runpy.run_path(os.path.join(r,'.codex','hooks','check.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
