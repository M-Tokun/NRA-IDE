{
  "schema_version": 1,
  "maximum_text_bytes": 20971520,
  "normalization_form": "NFC",
  "allowed_control_codepoints": [
    "U+0009",
    "U+000A",
    "U+000D"
  ],
  "binary_extensions": [
    ".7z",
    ".avi",
    ".bin",
    ".bz2",
    ".class",
    ".dll",
    ".docx",
    ".exe",
    ".gif",
    ".gz",
    ".ico",
    ".jar",
    ".jpeg",
    ".jpg",
    ".mov",
    ".mp3",
    ".mp4",
    ".npy",
    ".npz",
    ".otf",
    ".pdf",
    ".png",
    ".pptx",
    ".pyd",
    ".pyc",
    ".so",
    ".ttf",
    ".webp",
    ".woff",
    ".woff2",
    ".xlsx",
    ".zip"
  ],
  "rules": {
    "BIDI_CONTROL": "fail",
    "BOM": "fail",
    "CONTROL_CHARACTER": "fail",
    "FORMAT_CHARACTER": "warn",
    "INVISIBLE_FORMAT": "fail",
    "INVALID_UTF8": "fail",
    "LINE_SEPARATOR": "fail",
    "MIXED_SCRIPT_IDENTIFIER": "warn",
    "NONCHARACTER": "fail",
    "NON_NFC": "warn",
    "OVERSIZED_TEXT": "fail",
    "PATH_CONTROL": "fail",
    "PATH_MIXED_SCRIPT": "warn",
    "PATH_NON_NFC": "warn",
    "VARIATION_SELECTOR": "warn"
  }
}
