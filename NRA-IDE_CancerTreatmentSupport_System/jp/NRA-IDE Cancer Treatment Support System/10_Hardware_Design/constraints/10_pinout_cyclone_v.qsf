# ═══════════════════════════════════════════════════════════════════════
# File: pinout_cyclone_v.qsf
# Phase: 10
# Target: DE0-CV (Cyclone V)
# ═══════════════════════════════════════════════════════════════════════

# Device
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C7

# Clock (PIN_M9)
set_location_assignment PIN_M9 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk

# Reset (KEY0)
set_location_assignment PIN_U7 -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n

# UART (GPIO_0)
set_location_assignment PIN_W16 -to uart_rx
set_location_assignment PIN_V16 -to uart_tx

# LEDs
set_location_assignment PIN_AA2 -to led_status
set_location_assignment PIN_AA1 -to led_error
