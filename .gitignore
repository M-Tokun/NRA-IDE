# NRA-IDE .gitignore

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local settings
.claude/

# AGENTS.md読了マーカー（Claude/Codex/Gemini共通、セッションごとの実行時状態）
.agent_state/

# Editors
.vscode/*
!.vscode/settings.json
.idea/
.kilo/

# VS Code workspace files (contain local paths)
*.code-workspace

# Distribution
dist/
build/
*.egg-info/

# Private Local Reports
local_reports/
local_reportsDirectory/
# Gemini CLI
.gemini/*
!.gemini/settings.json

# Node.js（Gemini CLI・各種ツール）
node_modules/
.npmrc
*.lock
!package-lock.json

# Environment variables
.env
.env.*

# Python仮想環境
.venv/
venv/
env/

# Jupyter
*.ipynb_checkpoints/
.ipynb_checkpoints/

# TypeScript
*.js.map
*.d.ts

# Temporary files
*.tmp
*.bak
*.swp
*~

# Local Codex skills (shared skills referenced by AGENTS.md are tracked exceptions)
/skills/*
!/skills/nra-depth-guard/
!/skills/axis-boundary-reasoning/
!/skills/agents-md-guard/

# NRA-IDE clinical session outputs
output/
