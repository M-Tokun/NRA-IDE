#!/usr/bin/env bash
# Cline Unix PostToolUse hook. Cline 4.1.22 on Windows uses PostToolUse.ps1.
# The nested success/result payload is normalized by cline_adapter.py.
# Only a complete matching contract response can establish a read marker.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$(command -v python3 || command -v python)"
exec "$PY" "$DIR/../../skills/agents-md-guard/cline_mark.py"
