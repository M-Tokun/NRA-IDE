{
  "nra-prompt-gate": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python -B ../skills/prompt-gate/antigravity_prompt_gate.py",
        "timeout": 10
      }
    ]
  },
  "nra-agents-md-guard": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python -B ../skills/agents-md-guard/antigravity_session_start.py",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -B ../skills/agents-md-guard/antigravity_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "nra-outside-root-guard": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -B ../skills/outside-root-guard/antigravity_outside.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
