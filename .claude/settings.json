{
  "permissions": {
    "allow": [
      "Bash(git -c commit.gpgsign=false commit -m ' *)",
      "Bash(awk '{print $1}')",
      "Bash(git fetch *)",
      "Bash(git fsck *)",
      "Bash(python scripts/check_links.py)",
      "Bash(python -m unittest tests.test_nra_ide_reference -v)",
      "Bash(python nra-core/implementation/nra_ide_foundation_fixed_JP.py)",
      "Bash(git commit -m ' *)",
      "WebFetch(domain:zenodo.org)",
      "Bash(python -m unittest discover -v)",
      "Bash(echo \"EXIT_CODE=$?\")",
      "Bash(PYTHONIOENCODING=utf-8 python NRA-IDE_conformance_checks.py)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git config *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git branch *)",
      "Bash(git mv *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(python -)",
      "Bash(start *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(npm install *)",
      "Bash(uv pip install *)",
      "PowerShell(git push *)",
      "PowerShell(git config *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Move-Item *)",
      "PowerShell(choco install *)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git add -u*)",
      "Bash(git commit *--amend*)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git rebase *)",
      "Bash(git rm *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git cherry-pick *)",
      "PowerShell(git add -A*)",
      "PowerShell(git add --all*)",
      "PowerShell(git add .)",
      "PowerShell(git add -u*)",
      "PowerShell(git commit *--amend*)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(git restore *)",
      "PowerShell(git rebase *)",
      "PowerShell(git rm *)",
      "PowerShell(git stash drop*)",
      "PowerShell(git stash clear*)",
      "PowerShell(git cherry-pick *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *--delete*)",
      "Bash(git push * +*)",
      "Bash(git push +*)",
      "Bash(git *--no-verify*)",
      "Bash(git -c core.hooksPath=*)",
      "Bash(git config core.hooksPath *)",
      "Bash(git config --local core.hooksPath *)",
      "Bash(git config --global core.hooksPath *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git push * +*)",
      "PowerShell(git push +*)",
      "PowerShell(git *--no-verify*)",
      "PowerShell(git -c core.hooksPath=*)",
      "Bash(git filter-repo*)",
      "Bash(git filter-branch*)",
      "Bash(git reflog expire*)",
      "Bash(git gc *--prune*)",
      "PowerShell(git filter-repo*)",
      "PowerShell(git filter-branch*)",
      "PowerShell(git reflog expire*)",
      "PowerShell(git gc *--prune*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'skills','agents-md-guard','claude_guard.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'skills','agents-md-guard','claude_session_start.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
